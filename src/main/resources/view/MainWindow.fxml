<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="nimbus.ui.MainWindow"
      stylesheets="@../view/styles.css"
      spacing="10"
      prefWidth="420"
      prefHeight="600">

    <ScrollPane fx:id="scrollPane"
                hbarPolicy="NEVER"
                vbarPolicy="ALWAYS"
                fitToWidth="true"
                VBox.vgrow="ALWAYS">

        <VBox fx:id="dialogContainer"
              spacing="15"
              prefWidth="400">
            <padding>
                <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
            </padding>
        </VBox>
    </ScrollPane>

    <HBox spacing="10">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
        </padding>
        <TextField fx:id="userInput"
                   promptText="Type a command…"
                   onAction="#handleUserInput"
                   HBox.hgrow="ALWAYS"
                   style="-fx-background-radius: 15;"/>
        <Button fx:id="sendButton"
                text="Send"
                onAction="#handleUserInput"
                style="-fx-background-radius: 15; -fx-background-color: #0084FF; -fx-text-fill: white;"/>
    </HBox>
</VBox>

